# API Gateway
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://mindcare:mindcare@localhost:5432/mindcare
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
# If Windows blocks a port (WinError 10013), try 8010, 8080, etc. and match uvicorn --port
ML_CORE_URL=http://127.0.0.1:8010
# Must match the Vite dev URL (scheme + host + port) when the browser calls the API from a different origin:
CORS_ORIGIN=http://127.0.0.1:5173

# Web — Vite loads this file from repo root (mindcare/.env)
# If another app already uses 5173 / 4000 / 8000, change all four blocks together:
VITE_DEV_PORT=5173
VITE_PROXY_API=http://127.0.0.1:4000
VITE_API_URL=http://127.0.0.1:4000

# ML Core
ML_DEVICE=cpu
LOG_LEVEL=info
